{
  "name": "@okno/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "db:migrate": "node --env-file-if-exists=../.env dist/database/cli.js migrate",
    "db:admin": "node --env-file-if-exists=../.env dist/database/cli.js admin",
    "db:seed": "node --env-file-if-exists=../.env dist/database/cli.js seed",
    "demo:conflict": "node --env-file-if-exists=../.env dist/database/cli.js conflict",
    "test": "npm run build && node --test test/domain.test.mjs",
    "test:coverage": "npm run build && c8 --all --include 'dist/**/*.js' --reporter=lcov --reporter=text node --test test/domain.test.mjs ${TEST_DATABASE_URL:+test/api.integration.mjs}",
    "test:integration": "npm run build && node --test test/api.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.3"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "c8": "12.0.0",
    "supertest": "7.3.2"
  }
}
